# 운영 배포 플랫폼의 비밀 환경변수에 주입할 항목 목록이다.
# 로컬 .env와 운영 비밀을 공유하지 않는다.
SPRING_PROFILES_ACTIVE='prod'
SERVER_PORT='8080'

DB_URL=''
DB_USERNAME=''
DB_PASSWORD=''
REDIS_HOST=''
REDIS_PORT='6379'
REDIS_USERNAME='default'
REDIS_PASSWORD=''
REDIS_SSL_ENABLED='true'

CORS_ALLOWED_ORIGINS=''
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''
NAVER_REDIRECT_URI=''

JWT_ISSUER=''
JWT_AUDIENCE='pebble-api'
JWT_KEY_ID=''
JWT_PRIVATE_KEY_BASE64=''
JWT_PUBLIC_KEY_BASE64=''

REFRESH_TOKEN_PEPPER_BASE64=''
REFRESH_TOKEN_PEPPER_VERSION='v1'

# R2 미디어. 아래 필수 값을 채운 뒤 R2_ENABLED=true로 활성화한다.
# 비공개 버킷을 사용하고 대상 버킷의 Object Read & Write S3 자격 증명을 Secret으로 주입한다.
# API Token 원문 대신 발급 화면의 Access Key ID와 Secret Access Key를 사용한다.
# 계정 S3 endpoint 예: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (버킷 경로 제외)
# 관할권을 지정했다면 해당 버킷에 표시된 관할권 전용 endpoint를 사용한다.
R2_ENABLED='false'
R2_ENDPOINT=''
# 실제 운영에서 사용할 버킷 이름을 입력한다.
R2_BUCKET_NAME='pebble-media'
R2_REGION='auto'
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
