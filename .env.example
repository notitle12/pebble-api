# 이 파일을 .env로 복사하고 실제 비밀은 복사한 .env에만 입력한다.
# Spring Boot는 .env를 자동으로 읽지 않는다. docs/DEVELOPMENT.md의 실행 방법을 따른다.
SPRING_PROFILES_ACTIVE='local'
SERVER_PORT='8080'

DB_URL='jdbc:postgresql://localhost:5432/pebble'
DB_USERNAME='pebble'
DB_PASSWORD='pebble-local'
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_USERNAME=''
REDIS_PASSWORD=''
REDIS_SSL_ENABLED='false'

# 프런트엔드 Origin만 입력한다. 경로와 끝의 /를 넣지 않는다.
CORS_ALLOWED_ORIGINS='http://localhost:3000'
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''
# Naver Developers에 등록한 callback URL과 정확히 같아야 한다.
NAVER_REDIRECT_URI='http://localhost:3000/auth/naver/callback'

JWT_ISSUER='https://pebble.local'
JWT_AUDIENCE='pebble-api'
JWT_KEY_ID='local'
# Base64 DER 키: private는 PKCS#8, public은 X.509 형식이며 한 줄로 입력한다.
JWT_PRIVATE_KEY_BASE64=''
JWT_PUBLIC_KEY_BASE64=''ㅊ
# 32바이트 이상 난수의 Base64 값. JWT 키나 Naver 비밀과 별개로 생성한다.
REFRESH_TOKEN_PEPPER_BASE64=''
REFRESH_TOKEN_PEPPER_VERSION='v1'

# R2 미디어. 아래 필수 값을 채운 뒤 R2_ENABLED=true로 활성화한다.
# R2 > API Tokens에서 대상 버킷에 한정된 Object Read & Write 권한으로 발급한다.
# 생성 화면의 S3 자격 증명을 입력한다. API Token 원문을 Secret Access Key에 넣지 않는다.
# 비공개 버킷을 사용한다. r2.dev 공개 URL이나 사용자 지정 도메인은 필요하지 않다.
# 계정 S3 endpoint 예: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (버킷 경로 제외)
# 관할권을 지정했다면 해당 버킷에 표시된 관할권 전용 endpoint를 사용한다.
R2_ENABLED='false'
R2_ENDPOINT=''
# 실제 생성한 버킷 이름과 맞춘다.
R2_BUCKET_NAME='pebble-media'
# S3 서명에 사용하는 region이며 R2는 auto를 사용한다.
R2_REGION='auto'
R2_ACCESS_KEY_ID=''
R2_SECRET_ACCESS_KEY=''
