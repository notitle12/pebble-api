# 로컬 실행용. 실제 비밀은 이 파일에만 입력하고 Git에 추가하지 않는다.
# Spring Boot는 .env를 자동으로 읽지 않는다. docs/DEVELOPMENT.md의 실행 방법을 따른다.
SPRING_PROFILES_ACTIVE='local'
SERVER_PORT='8080'

DB_URL='jdbc:postgresql://localhost:5432/pebble'
DB_USERNAME='pebble'
DB_PASSWORD='pebble-local'
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_USERNAME=''
REDIS_PASSWORD=''
REDIS_SSL_ENABLED='false'

# 프런트엔드 Origin만 입력한다. 경로와 끝의 /를 넣지 않는다.
CORS_ALLOWED_ORIGINS='http://localhost:3000'
NAVER_CLIENT_ID=''
NAVER_CLIENT_SECRET=''
# Naver Developers에 등록한 callback URL과 정확히 같아야 한다.
NAVER_REDIRECT_URI='http://localhost:3000/auth/naver/callback'

JWT_ISSUER='https://pebble.local'
JWT_AUDIENCE='pebble-api'
JWT_KEY_ID='local'
# Base64 DER 키: private는 PKCS#8, public은 X.509 형식이며 한 줄로 입력한다.
JWT_PRIVATE_KEY_BASE64=''
JWT_PUBLIC_KEY_BASE64=''
# 32바이트 이상 난수의 Base64 값. JWT 키나 Naver 비밀과 별개로 생성한다.
REFRESH_TOKEN_PEPPER_BASE64=''
REFRESH_TOKEN_PEPPER_VERSION='v1'
