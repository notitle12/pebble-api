# 이 파일을 application-local.yaml로 복사해 로컬 환경을 설정한다.
# 비밀 값은 .env 또는 실행 환경변수로 제공한다.
server:
  port: ${SERVER_PORT:8080}

spring:
  application:
    name: pebble-api
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/pebble}
    username: ${DB_USERNAME:pebble}
    password: ${DB_PASSWORD:pebble-local}
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      username: ${REDIS_USERNAME:}
      password: ${REDIS_PASSWORD:}
      ssl:
        enabled: ${REDIS_SSL_ENABLED:false}

pebble:
  # R2는 명시적으로 활성화한 경우에만 접속한다.
  # 비밀은 환경변수로 주입한다. 실제 .env는 Spring Boot가 자동으로 읽지 않는다.
  media:
    r2:
      enabled: ${R2_ENABLED:false}
      # 버킷 경로가 없는 계정 S3 endpoint이며 공개 이미지 URL과 다르다.
      endpoint: ${R2_ENDPOINT:}
      bucket-name: ${R2_BUCKET_NAME:pebble-media}
      region: ${R2_REGION:auto}
      # R2 발급 화면의 S3 자격 증명이며 API Token 원문은 사용하지 않는다.
      access-key-id: ${R2_ACCESS_KEY_ID:}
      secret-access-key: ${R2_SECRET_ACCESS_KEY:}
  admin:
    bootstrap:
      enabled: ${ADMIN_BOOTSTRAP_ENABLED:false}
      login-id: ${ADMIN_BOOTSTRAP_LOGIN_ID:}
      password: ${ADMIN_BOOTSTRAP_PASSWORD:}
  security:
    cors:
      allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:3000}
  auth:
    naver:
      client-id: ${NAVER_CLIENT_ID:}
      client-secret: ${NAVER_CLIENT_SECRET:}
      redirect-uri: ${NAVER_REDIRECT_URI:http://localhost:3000/auth/naver/callback}
      authorization-uri: https://nid.naver.com/oauth2.0/authorize
      token-uri: https://nid.naver.com/oauth2.0/token
      profile-uri: https://openapi.naver.com/v1/nid/me
      state-ttl: 5m
    jwt:
      issuer: ${JWT_ISSUER:https://pebble.local}
      audience: ${JWT_AUDIENCE:pebble-api}
      private-key-base64: ${JWT_PRIVATE_KEY_BASE64:}
      public-key-base64: ${JWT_PUBLIC_KEY_BASE64:}
      key-id: ${JWT_KEY_ID:local}
    refresh-token:
      pepper-base64: ${REFRESH_TOKEN_PEPPER_BASE64:}
      pepper-version: ${REFRESH_TOKEN_PEPPER_VERSION:v1}
      previous-peppers: {}
