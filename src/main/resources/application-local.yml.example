# ==========================================
# application-local.yml 템플릿 파일
# ==========================================
# 로컬 개발 환경에서 이 파일을 복사하여 application-local.yml을 생성할 수 있습니다.
# application-local.yml 파일은 .gitignore에 등록되어 Git에 커밋되지 않습니다.
# Docker Compose의 .env 설정과 기본값이 일치하도록 구성되어 있습니다.
spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://${POSTGRES_HOST:localhost}:${POSTGRES_PORT:5432}/${POSTGRES_DB:pebble_db}}
    username: ${DB_USERNAME:${POSTGRES_USER:pebble_user}}
    password: ${DB_PASSWORD:${POSTGRES_PASSWORD:pebble_password}}
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: update

  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}

logging:
  level:
    org.hibernate.SQL: DEBUG
    org.hibernate.orm.jdbc.bind: TRACE
